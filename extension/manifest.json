{
  "manifest_version": 3,
  "name": "TubeGrab",
  "version": "2.2.0",
  "description": "Adds native MP3 and MP4 download actions to YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["http://127.0.0.1:17843/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "css": ["style.css"],
    "run_at": "document_idle"
  }]
}
